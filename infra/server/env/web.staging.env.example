# VirtualWait Web — staging example.
# Copy to a controlled path outside the repository, chmod 0600, then replace
# every CHANGE_ME_* value with a unique secret. Never reuse production values.
NODE_ENV=production
APP_BASE_URL=https://wait-staging.example.com
VIRTUALWAIT_DATA_DIR=/var/lib/virtualwait-staging/web
VIRTUALWAIT_BACKUP_DIR=/var/backups/virtualwait-staging

# Identity: every player has a local account (username + password + nickname).
SESSION_MAX_AGE_DAYS=30
SESSION_SECRET=CHANGE_ME_STAGING_SESSION_SECRET_64_HEX
ADMIN_API_TOKEN=CHANGE_ME_STAGING_ADMIN_API_TOKEN_64_HEX

# Self-service registration. REGISTRATION_ENABLED=false closes sign-ups.
REGISTRATION_ENABLED=true
# CHECKIN_REQUIRED=true requires a live venue check-in code at registration.
CHECKIN_REQUIRED=true
CHECKIN_WINDOW_SEC=600
CHECKIN_GRACE_WINDOWS=1
REGISTER_IP_LIMIT=5
REGISTER_IP_WINDOW_SEC=3600
REGISTER_GLOBAL_LIMIT=40
REGISTER_GLOBAL_WINDOW_SEC=3600
LOGIN_IP_LIMIT=10
LOGIN_IP_WINDOW_SEC=300
LOGIN_ACCOUNT_LIMIT=8
LOGIN_ACCOUNT_WINDOW_SEC=300
IP_ACCOUNT_QUOTA_PER_DAY=5

# Optional: QQ bot (services/bot) queue-notify bearer. Leave empty to disable /api/bot/*.
BOT_API_TOKEN=
BOT_CATALOG_RATE_LIMIT=20
BOT_QUEUE_RATE_LIMIT=240

TRUST_PROXY_HEADERS=true
# Listen address of `npm run start`. Keep loopback so nothing can bypass the
# proxy and forge X-Forwarded-For; change only for container networking and
# make sure the port is unreachable from outside.
HOST=127.0.0.1
PORT=3002

PLAYING_TIMEOUT_SEC=1500
HEAD_CONFIRM_TIMEOUT_SEC=180
# Set false to allow queueing without a bound QQ (bot @ reminders are skipped).
REQUIRE_QQ_FOR_QUEUE=true

MAINTENANCE_INTERVAL_SEC=15
DB_BUSY_TIMEOUT_MS=5000
RATE_LIMIT_BUCKET_RETENTION_SEC=3600
IP_BINDING_RETENTION_DAYS=2
LOGIN_METADATA_RETENTION_DAYS=180
QUEUE_HISTORY_RETENTION_DAYS=180
AUDIT_EVENT_RETENTION_DAYS=365
