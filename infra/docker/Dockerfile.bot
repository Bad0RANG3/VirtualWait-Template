# VirtualWait QQ 机器人镜像（可复用）。
#
# 设计约束：
# - 只复制 services/bot、packages/sdgb-client 与入口脚本，**不复制**个人/机厅私有覆盖
#   （settings_local.py / .env* / napcat/ / data/ 等）；
# - SDGB 公开默认参数已内置在 packages/sdgb-client/sdgb/settings.py，开箱即用；
#   换机厅时用 VW_SDGB_* 环境变量覆盖。
# - 与 docker-compose.bot.yml 配套：拉起后唯一手动步骤是扫码登录机器人 QQ。
#
# 构建（可选，通常直接用预构建镜像）：
#   docker build -f infra/docker/Dockerfile.bot -t virtualwait-bot:latest .
# 国内加速：
#   docker build --build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple -f infra/docker/Dockerfile.bot -t virtualwait-bot:latest .

FROM python:3.12-slim

ARG VERSION=dev
ARG PIP_INDEX_URL=https://pypi.org/simple

LABEL org.opencontainers.image.title="virtualwait-bot" \
      org.opencontainers.image.description="VirtualWait QQ 机器人（NoneBot2 + sdgb-client，NapCat OneBot v11）" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/Bad0RANG3/VirtualWait-Template"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    B50_DATA_DIR=/data

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app --home /app app

COPY services/bot/requirements.txt ./services/bot/requirements.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" -r services/bot/requirements.txt

COPY --chown=app:app services/bot ./services/bot
COPY --chown=app:app packages/sdgb-client ./packages/sdgb-client
COPY --chown=app:app infra/docker/entrypoint.bot.sh /usr/local/bin/virtualwait-bot

RUN mkdir -p /data \
    && chown -R app:app /data \
    && chmod +x /usr/local/bin/virtualwait-bot

USER app

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import sys; sys.exit(0 if b'services/bot/bot.py' in open('/proc/1/cmdline', 'rb').read() else 1)"

ENTRYPOINT ["virtualwait-bot"]
CMD ["python", "services/bot/bot.py"]