{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtualwait.local/schemas/score-write-job-create-request.v1.json",
  "title": "CreateScoreWriteJobRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["qrCode", "scores"],
  "properties": {
    "qrCode": { "type": "string", "minLength": 20, "maxLength": 2048 },
    "scores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{1,7}:[0-4]:[0-9]{1,7}(\\.[0-9]{1,4})?%?(:[0-4](?::[0-5])?)?$"
      }
    },
    "confirm": { "type": "boolean" }
  }
}
