# ============================================================
# NoneBot2 基础配置
# ============================================================
HOST=0.0.0.0
PORT=8080
DRIVER=~httpx+~websockets
# NapCat（OneBot v11 正向 WebSocket 服务端）地址。Docker 内为 ws://napcat:3001
ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]

# ============================================================
# 队列空闲通知（queue_notify 插件）
# ============================================================
# 是否启用轮询（false 可单独关闭通知）
QUEUE_NOTIFY_ENABLED=true
# VirtualWait Web 根地址（无尾斜杠）
QUEUE_NOTIFY_BASE_URL=http://127.0.0.1:3000
# 与 Web .env 的 BOT_API_TOKEN 一致（留空则通知插件报错并退避）
QUEUE_NOTIFY_BOT_TOKEN=
QUEUE_NOTIFY_POLL_INTERVAL_SEC=5
QUEUE_NOTIFY_REMINDER_MINUTES=3
QUEUE_NOTIFY_WARMUP_ROUNDS=2
# 兜底群号（纯数字）；路由优先级：场地 groupUmo -> ROUTING -> DISTRICT_ROUTING -> DEFAULT
QUEUE_NOTIFY_DEFAULT_GROUP=
# venueSlug -> 群号 的 JSON
QUEUE_NOTIFY_ROUTING={}
# district:<slug> -> 群号 的 JSON
QUEUE_NOTIFY_DISTRICT_ROUTING={}
QUEUE_NOTIFY_STATS_INTERVAL_SEC=600
QUEUE_NOTIFY_MAX_BACKOFF_SEC=120
